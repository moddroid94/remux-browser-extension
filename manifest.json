{
  "manifest_version": 3,
  "name": "m3u8DL-Sniffer",
  "description": "m3u8dl sniffer and remux companion",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "m3u8DL Sniffer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "cookies",
    "activeTab",
    "unlimitedStorage",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "*://*/*",
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "incognito": "split"
}
